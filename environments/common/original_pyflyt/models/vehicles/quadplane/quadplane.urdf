<?xml version="1.0" ?>

<robot name="quadplane">

  <!-- NOTE (tensorized port): upstream PyFlyt ships this airframe with the
       nose along +Y (fuselage/wing-chord along Y, wingspan along X), which
       conflicts with every other vehicle in this stack (nose = +X, pitch
       about +Y, roll about +X). All joint frames below are rotated by -90
       deg about Z relative to upstream (xyz' = (y, -x, z), rpy z -= pi/2),
       which places the tail at x=-1.1, wing at x=-0.5, ailerons at
       (-0.5, +-0.95) and fuselage at x=-0.45, i.e. byte-for-byte the
       fixedwing layout. The quad motors sit at x = +0.05 (front pair) / -0.95 (rear
       pair), y = +-0.5, centered on the CG; the pusher motor is at the
       origin (nose) and thrusts along +X. -->

  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.1 0.2 0.2"/>
      </geometry>
    </collision>
  </link>


  <link name="motor_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <joint name="motor_joint" type="fixed">
    <origin rpy="0 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="motor_link"/>
  </joint>


  <link name="horizontal_tail_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.6 0.3 0.1"/>
      </geometry>
    </collision>
  </link>
  <joint name="horizontal_tail_joint" type="fixed">
    <origin rpy="0 0 -1.5707963267948966" xyz="-1.1 0 0"/>
    <parent link="base_link"/>
    <child link="horizontal_tail_link"/>
  </joint>


  <link name="vertical_tail_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.1 0.3 0.3"/>
      </geometry>
    </collision>
  </link>
  <joint name="vertical_tail_joint" type="fixed">
    <origin rpy="0 0 -1.5707963267948966" xyz="-1.1 0 0.15"/>
    <parent link="base_link"/>
    <child link="vertical_tail_link"/>
  </joint>


  <link name="ail_left_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.3 0.3 0.1"/>
      </geometry>
    </collision>
  </link>
  <joint name="ail_left_joint" type="fixed">
    <origin rpy="0 0 -1.5707963267948966" xyz="-0.5 0.95 0"/>
    <parent link="base_link"/>
    <child link="ail_left_link"/>
  </joint>


  <link name="ail_right_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.3 0.3 0.1"/>
      </geometry>
    </collision>
  </link>
  <joint name="ail_right_joint" type="fixed">
    <origin rpy="0 0 -1.5707963267948966" xyz="-0.5 -0.95 0"/>
    <parent link="base_link"/>
    <child link="ail_right_link"/>
  </joint>


  <link name="main_wing_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="1.8 0.3 0.1"/>
      </geometry>
    </collision>
  </link>
  <joint name="main_wing_joint" type="fixed">
    <origin rpy="0 0 -1.5707963267948966" xyz="-0.5 0 0"/>
    <parent link="base_link"/>
    <child link="main_wing_link"/>
  </joint>


  <link name="fuselage_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.2 1.4 0.2"/>
      </geometry>
    </collision>
  </link>
  <joint name="fuselage_joint" type="fixed">
    <origin rpy="0 0 -1.5707963267948966" xyz="-0.45 0 0"/>
    <parent link="base_link"/>
    <child link="fuselage_link"/>
  </joint>


  <link name="prop1_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.02"/>
      </geometry>
    </collision>
  </link>
  <joint name="prop1_joint" type="fixed">
    <origin rpy="0 0 -1.5707963267948966" xyz="0.05 -0.5 0"/>
    <parent link="base_link"/>
    <child link="prop1_link"/>
  </joint>

  <link name="prop2_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.02"/>
      </geometry>
    </collision>
  </link>
  <joint name="prop2_joint" type="fixed">
    <origin rpy="0 0 -1.5707963267948966" xyz="-0.95 0.5 0"/>
    <parent link="base_link"/>
    <child link="prop2_link"/>
  </joint>

  <link name="prop3_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.02"/>
      </geometry>
    </collision>
  </link>
  <joint name="prop3_joint" type="fixed">
    <origin rpy="0 0 -1.5707963267948966" xyz="0.05 0.5 0"/>
    <parent link="base_link"/>
    <child link="prop3_link"/>
  </joint>

  <link name="prop4_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.02"/>
      </geometry>
    </collision>
  </link>
  <joint name="prop4_joint" type="fixed">
    <origin rpy="0 0 -1.5707963267948966" xyz="-0.95 -0.5 0"/>
    <parent link="base_link"/>
    <child link="prop4_link"/>
  </joint>


</robot>
